{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corleone Panel",
  "version": "0.1.0",
  "identifier": "com.samet.corleone-panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Corleone Panel",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["corleone-panel"]
      }
    },
    "updater": {
      "endpoints": ["https://corleoneteam.com.tr/panel/releases/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzN0RDRjkzMUUyRkU4MkUKUldRdTZDOGVrODk5TTFzTWJWbGQxdHNMemp2UVoxTUdYd0Y3c0c4cEkrZ3hXejdTSXJPNFJYTkIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
