{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:scope-home-recursive",
    "dialog:allow-save",
    "dialog:allow-open",
    "updater:default",
    "process:default",
    "deep-link:default"
  ]
}
